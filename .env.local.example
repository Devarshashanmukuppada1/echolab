# EchoLab Environment Variables
# Copy this file to .env.local and fill in your values

# SenseNova API Configuration
SENSENOVA_API_KEY=your_sensenova_api_key_here
SENSENOVA_VOICE_ENDPOINT=https://api.sensenova.cn/voice
SENSENOVA_TTS_ENDPOINT=https://api.sensenova.cn/tts
SENSENOVA_VOICE_CLONE_ENDPOINT=https://api.sensenova.cn/voice-clone

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_ENDPOINT=wss://api.sensenova.cn/voice-ws

# Authentication
NEXT_PUBLIC_AUTH_TOKEN=your_auth_token_here

# Audio Configuration
NEXT_PUBLIC_AUDIO_SAMPLE_RATE=48000
NEXT_PUBLIC_AUDIO_BITRATE=128000
NEXT_PUBLIC_AUDIO_FORMAT=mp3

# Feature Flags
NEXT_PUBLIC_ENABLE_VOICE_CLONING=true
NEXT_PUBLIC_ENABLE_ADVANCED_TTS=true
NEXT_PUBLIC_ENABLE_WEBSOCKET_AUDIO=true
NEXT_PUBLIC_ENABLE_REAL_TIME_VISUALIZATION=true

# Rate Limiting
NEXT_PUBLIC_API_RATE_LIMIT=100
NEXT_PUBLIC_VOICE_CLONE_RATE_LIMIT=10

# Cache Configuration
NEXT_PUBLIC_CACHE_TTL=3600
NEXT_PUBLIC_AUDIO_CACHE_SIZE=100

# Monitoring
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_GA_ID=your_ga_id_here